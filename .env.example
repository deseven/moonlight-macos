# Copy this file to .env and fill in the values. build.sh sources it as a shell
# script, so quote values containing spaces.

# ── Code Signing ──────────────────────────────────────────────────────
# Developer ID Application certificate identity (e.g. "Developer ID Application: Your Name (TEAMID)"),
# could be found with `security find-identity -v -p codesigning`.
# Required for `dev-release`. If not set, `dev` builds are ad-hoc signed (without hardened runtime).
MOONLIGHT_SIGNING_IDENTITY=""

# ── Notarization ─────────────────────────────────────────────────────
# Used by `dev-release`. If neither option is configured, the build is signed but not notarized.
#
# Option A: Keychain profile (preferred)
# Store credentials first with:
#   xcrun notarytool store-credentials "PROFILE_NAME" \
#     --apple-id "you@example.com" \
#     --team-id "XXXXXXXXXX" \
#     --password "xxxx-xxxx-xxxx-xxxx"
# Then set the profile name here:
MOONLIGHT_NOTARY_PROFILE=""

# Option B: Inline credentials (fallback if no keychain profile)
# The password is an app-specific password, created at https://account.apple.com
# MOONLIGHT_APPLE_ID="you@example.com"
# MOONLIGHT_TEAM_ID="XXXXXXXXXX"
# MOONLIGHT_APP_PASSWORD="xxxx-xxxx-xxxx-xxxx"
